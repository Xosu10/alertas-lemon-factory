# URL del webhook del canal de Discord (Configuración del canal -> Integraciones -> Webhooks)
DISCORD_WEBHOOK_URL=

# Minutos que faltan para cada alerta
FIRST_ALERT_MINUTES=60
SECOND_ALERT_MINUTES=30

# Hora (España, formato 24h) del resumen diario (de lunes a viernes) y, los lunes, del semanal
SUMMARY_HOUR=1
